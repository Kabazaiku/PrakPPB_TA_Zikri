# Salin file ini menjadi ".env" (persis, tanpa .txt), letakkan di folder yang sama dengan package.json.
# Isi dari Supabase: Project Settings > API (atau tombol Connect).
# Tanpa tanda kutip, tanpa spasi di sekitar tanda "=", tanpa garis miring di akhir URL.

SUPABASE_URL=https://abcdefghijklmnop.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.isi-bagian-tengah.isi-bagian-akhir

# Pakai kunci "anon public" (diawali eyJ...) atau "publishable" (diawali sb_publishable_...).
# JANGAN pakai service_role / secret key.
